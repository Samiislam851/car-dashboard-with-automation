// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("admin")
  createdAt    DateTime @default(now()) @map("created_at")

  vehicles Vehicle[]
  bookings Booking[]

  @@map("users")
}

model Vehicle {
  id          String   @id @default(uuid())
  name        String
  category    String?
  pricePerDay Decimal  @map("price_per_day")
  transmission String?
  fuelType    String?  @map("fuel_type")
  seats       Int?
  status      String   @default("available")
  imageUrl    String?  @map("image_url")
  ownerId     String?  @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")

  owner    User?     @relation(fields: [ownerId], references: [id])
  bookings Booking[]

  @@map("vehicles")
}

model Booking {
  id            String    @id @default(uuid())
  vehicleId     String    @map("vehicle_id")
  userId        String?   @map("user_id")
  customerName  String?   @map("customer_name")
  startLocation String?   @map("start_location")
  endLocation   String?   @map("end_location")
  startTime     DateTime? @map("start_time")
  endTime       DateTime? @map("end_time")
  price         Decimal?
  paymentMethod String?   @map("payment_method")
  status        String    @default("pending")
  country       String?
  createdAt     DateTime  @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@map("bookings")
}

// Knowledge base for retrieval-augmented chat. `embedding` has no native Prisma
// scalar (pgvector isn't a first-class Prisma type), so it's declared as
// Unsupported and only ever read/written via $queryRaw / $executeRaw.
model KnowledgeChunk {
  id        String                      @id @default(uuid())
  category  String
  content   String
  embedding Unsupported("vector(384)")
  createdAt DateTime                    @default(now()) @map("created_at")

  @@map("knowledge_chunks")
}
